# Google OAuth client (Drive API, drive.file scope)
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# Path to the file where the Drive refresh token is persisted after the
# one-time device-grant approval. Not committed, not on Drive itself.
DRIVE_TOKEN_PATH=./data/drive-token.json

# Drive folder all app data files live in. Dev and prod must use two
# distinct real folder names (not a shared name with a prefix/suffix trick)
# so they're separate, independently browsable folders in Drive.
DRIVE_FOLDER_NAME=wedding-planning-data-dev

# Shared passwords for the editor/vendor roles. Plaintext, same treatment
# as the other secrets in this file — not stored in Drive.
EDITOR_PASSWORD=change-me
VENDOR_PASSWORD=change-me

# JWT signing secret for session cookies.
SESSION_SECRET=change-me

PORT=3000

# Activity log — a plain local file on the Pi, deliberately not on Drive.
# Lives under ./data so it persists across container rebuilds (docker-compose
# bind-mounts that directory) and is gitignored along with the rest of data/.
ACTIVITY_LOG_PATH=./data/activity.log

# Venue name, shown in the page title/subtitle across all sub-projects.
# Not a secret, but it's PII (identifies a real location) so it's env-config
# rather than hardcoded in the repo's HTML.
VENUE_NAME=change-me

# Main wedding website — shown as a banner link on the landing page.
# Leave blank to hide the banner entirely.
WEDDING_SITE_URL=change-me
